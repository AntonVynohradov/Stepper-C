{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "SSTEP[Debug]",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "SSTEP[Release]",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "SSTEP[UnitTests]",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "UNIT_TESTS": "ON",
                "SSTEP_MATH_BACKEND": "FIXED"
            }
        },
        {
            "name": "SSTEP[UnitTestsFloat]",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "UNIT_TESTS": "ON",
                "SSTEP_MATH_BACKEND": "FLOAT"
            }
        }
    ]
}