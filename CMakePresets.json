{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "[Debug]Stepper Motor Control",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "[Release]Stepper Motor Control",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "[UnitTests]Stepper Motor Control",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SSTEP_UNIT_TESTS": "ON",
                "SSTEP_MATH_BACKEND": "FIXED"
            }
        },
        {
            "name": "[UnitTestsFloat]Stepper Motor Control",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SSTEP_UNIT_TESTS": "ON",
                "SSTEP_MATH_BACKEND": "FLOAT"
            }
        }
    ]
}