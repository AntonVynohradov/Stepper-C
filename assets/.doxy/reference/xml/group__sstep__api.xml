<parametername><ref refid="group__sstep__defs_1ga145c9925476a6618b7d317935623ef33" kindref="member">SSTEP_ERR_STATE</ref></parametername>
</parameternamelist>
<parameterdescription>
<para>(faulted or self-test running), <ref refid="group__sstep__defs_1gad93b8d75937e0aba07a27ad33c058760" kindref="member">SSTEP_ERR_VBUS</ref>. </para>
