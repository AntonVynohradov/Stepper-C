<para>Built with <ref refid="group__sstep__config_1ga80128e9a8782edd49b5020c2ddba6e94" kindref="member">SSTEP_CFG_SELFTEST</ref> = 0. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
